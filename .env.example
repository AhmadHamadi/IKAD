# Copy this file to `.env` (gitignored) and fill in real values for local dev.
# In production (Vercel), set the same variables under
# Project Settings → Environment Variables.

# --- SMTP (required) ---
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=forms@example.com
SMTP_PASS=replace-me

# --- Quote form delivery (optional; sensible defaults baked into api/quote.js) ---
# QUOTE_TO_EMAIL=Saifsabeeh.31@gmail.com
# QUOTE_FROM_EMAIL=IKAD Mechanical <forms@example.com>
# QUOTE_SUBJECT_PREFIX=[IKAD Quote]

# --- Instant Estimator delivery (optional; api/estimate.js) ---
# Where estimator leads go. Falls back to QUOTE_TO_EMAIL, then the baked-in default.
# ESTIMATE_TO_EMAIL=Saifsabeeh.31@gmail.com
# Set to 0 to stop emailing homeowners a copy of their own estimate.
# ESTIMATE_SEND_COPY=1

# --- Spam filtering (optional; shared by /api/quote and /api/estimate) ---
# Subject tag added to suspected spam so it's obvious in the inbox / easy to filter.
# QUOTE_SPAM_SUBJECT_TAG=[SPAM?]
# Score at which a lead is tagged as suspected spam (still delivered). Lower = stricter.
# QUOTE_SPAM_FLAG_SCORE=5
# Score at which a lead is never emailed, only logged. Raise if a real lead is ever lost.
# QUOTE_SPAM_BLOCK_SCORE=12
# If set, blocked spam is sent HERE instead of being dropped (useful for an audit inbox).
# QUOTE_SPAM_TO_EMAIL=spam@example.com
# Hosts the form is allowed to be submitted from; anything else scores as off-site.
# QUOTE_ALLOWED_HOSTS=ikad.ca,vercel.app,localhost
